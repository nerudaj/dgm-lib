{
    "version": 10,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 31,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/_build-${presetName}",
            "cacheVariables": {
                "CMAKE_CXX_EXTENSIONS": "OFF"
            }
        },
        {
            "name": "clang",
            "inherits": "base",
            "generator": "Ninja Multi-Config",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang$penv{CLANG_SUFFIX}",
                "CMAKE_CXX_COMPILER": "clang++$penv{CLANG_SUFFIX}",
                "CMAKE_CXX_FLAGS": "-stdlib=libc++"
            }
        },
        {
            "name": "msvc-2022",
            "inherits": "base",
            "generator":"Visual Studio 17 2022",
            "architecture": "x64",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
        }
    ],
    "buildPresets": [
        {
            "name": "clang",
            "configurePreset": "clang",
            "configuration": "Debug"
        },
        {
            "name": "msvc-2022",
            "configurePreset": "msvc-2022",
            "configuration": "Debug"
        }
    ],
    "testPresets": [
        {
            "name": "clang",
            "configurePreset": "clang",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "msvc-2022",
            "configurePreset": "msvc-2022",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}