function (find_or_fetch_dependency)
    set ( oneValueArgs DONT_LOOK DONT_FETCH PACKAGE_NAME VERSION CPM_URL )
    set ( multiValueArgs COMPONENTS )
    cmake_parse_arguments ( fofd "" "${oneValueArgs}" "${multiValueArgs}" ${ARGN} )

    if ( NOT fofd_DONT_LOOK )
        set ( fofd_DONT_LOOK FALSE )
    endif()
    
    if ( NOT fofd_DONT_FETCH )
        set ( fofd_DONT_FETCH FALSE )
    endif()

    if ( NOT fofd_PACKAGE_NAME )
        message ( FATAL_ERROR "dgm-lib: find_or_fetch_dependency: PACKAGE_NAME is required!" )
    endif()
    
    if ( NOT fofd_VERSION )
        message ( FATAL_ERROR "dgm-lib: find_or_fetch_dependency: VERSION is required!" )
    endif()
    
    if ( fofd_COMPONENTS )
        set ( fofd_COMPONENTS COMPONENTS ${fofd_COMPONENTS} )
    endif()

    set ( DEP_FOUND FALSE )
    if ( fofd_DONT_LOOK )
        message ( STATUS "dgm-lib: Not looking for ${fofd_PACKAGE_NAME}, using CPM to download it" )
    else ()
        message ( STATUS "dgm-lib: Looking for ${fofd_PACKAGE_NAME}, using find_package..." )
        find_package ( ${fofd_PACKAGE_NAME} ${fofd_VERSION} QUIET ${fofd_COMPONENTS} )

        if ( ${fofd_PACKAGE_NAME}_FOUND )
            set ( DEP_FOUND TRUE )
            message ( STATUS "dgm-lib: ${fofd_PACKAGE_NAME} found: version ${${fofd_PACKAGE_NAME}_VERSION} and ${${fofd_PACKAGE_NAME}_DIR}" )
        endif()
    endif()

    if ( NOT DEP_FOUND )
        if ( fofd_DONT_FETCH )
            message ( FATAL_ERROR "dgm-lib: ${fofd_PACKAGE_NAME} not found, auto-fetching is disabled, exiting!" )
        else ()
            message ( "dgm-lib: ${fofd_PACKAGE_NAME} not found, using CPM to download it" )
            if ( fofd_CPM_URL )
                CPMAddPackage( "${fofd_CPM_URL}" )
            else ()
                message ( FATAL_ERROR "dgm-lib: CPM_URL is required for fetching ${fofd_PACKAGE_NAME}!" )
            endif()
        endif()
    endif()

endfunction()
